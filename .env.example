# Resume Parser - Environment Configuration
# Copy this file to .env and fill in your values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI / Azure OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
# For Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Dataverse Configuration
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_CLIENT_ID=your-app-client-id
DATAVERSE_CLIENT_SECRET=your-app-client-secret
DATAVERSE_TENANT_ID=your-tenant-id
DATAVERSE_TABLE_NAME=cr_resumedata

# Tesseract OCR Path (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Copilot Studio
COPILOT_STUDIO_BOT_ID=your-bot-id
COPILOT_STUDIO_TENANT_ID=your-tenant-id
COPILOT_STUDIO_ENVIRONMENT_ID=your-env-id

# Power Automate
POWER_AUTOMATE_FLOW_URL=https://prod-XX.westus.logic.azure.com:443/workflows/...

# File Storage
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
STANDARDIZED_OUTPUT_DIR=outputs
